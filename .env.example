# .env.example for NETCONF Gateway

# Database settings
DB_HOST=fake-postgres-db.example.com
DB_PORT=5432
DB_NAME=fake_db_name
DB_USER=fake_db_user
DB_PASSWORD=fake_db_password

# Router credentials
ROUTER_USERNAME=fake_router_user
ROUTER_PASSWORD=fake_router_pass

# Proxy credentials
PROXY_USERNAME=fake_proxy_user
PROXY_PASSWORD=fake_proxy_pass

# Config file paths (optional overrides)
DB_CLIENT_CONFIG_PATH=./config/db_client_config.json
PROXY_CONFIG_PATH=./config/proxy_map.json
CLIENT_CONFIG_PATH=./config/client_map.json


